HOST=127.0.0.1
PORT=3001
POSTGRES_USER=dean
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=dean
POSTGRES_PORT=5433
DATABASE_URL=postgresql://dean:local_dev_only@127.0.0.1:5433/dean

# Set unique demo passwords (12+ characters) before db:seed
SEED_STUDENT_1_PASSWORD=
SEED_STUDENT_2_PASSWORD=

# Browser origin (Vite); set HTTPS origin in production
APP_ORIGIN=http://localhost:5173

# Random secret, at least 32 bytes
JWT_SECRET=
# Web Push: generate one key pair once via npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
SEED_TEACHER_PASSWORD=

SEED_STAFF_PASSWORD=

# Dedicated PostgreSQL database for integration tests; never use production here
TEST_DATABASE_URL=

# Разбор успеваемости ИИ (YandexGPT). Пусто или off — ИИ выключен, страница «Предметы» показывает расчёт по баллам; mock — ответы без сети для разработки.
# Ключ API сервисного аккаунта с ролью ai.languageModels.user и ID каталога Yandex Cloud. Не коммитьте ключ.
AI_PROVIDER=
AI_API_KEY=
AI_FOLDER_ID=
# Необязательно: модель (по умолчанию yandexgpt-lite/latest) и лимит вызовов модели в час на пользователя (по умолчанию 20)
AI_MODEL=
AI_LIMIT_PER_HOUR=
